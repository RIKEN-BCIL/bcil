<?xml version="1.0" encoding="UTF-8"?>
<SceneFile Version="3">
    <SceneInfoDirectory>
        <BalsaStudyID></BalsaStudyID>
        <BalsaStudyTitle></BalsaStudyTitle>
        <BalsaBaseDirectory></BalsaBaseDirectory>
        <BalsaExtractToDirectory></BalsaExtractToDirectory>
        <BasePathType>CUSTOM</BasePathType>
        <SceneInfo Index="0">
            <Name>SubjectID surfaces (MNINonLinear space)</Name>
            <BalsaSceneID></BalsaSceneID>
            <Description>Surfaces in MNINonLinear (164k atlas) space.

Display aparc+aseg and wmparc overlays in the volume.
</Description>
            <Image Encoding="Base64" Format="png"></Image>
        </SceneInfo>
        <SceneInfo Index="1">
            <Name>SubjectID  Myelin Map, Sulc and Areal Distortion</Name>
            <BalsaSceneID></BalsaSceneID>
            <Description>Subject's MyelinMap in top; group average MyelinMap in 2nd row; subject's Sulc in 3rd row; group avreage Sulc in 4th row; ArealDistortion of MSMSulc in 5th row;ArealDistortion of MSMAll in 6th row.


</Description>
            <Image Encoding="Base64" Format="png"></Image>
        </SceneInfo>
        <SceneInfo Index="2">
            <Name>SubjectID Surface defect map 5</Name>
            <BalsaSceneID></BalsaSceneID>
            <Description>Estimated 'surface defect' based on the robust z-score of MyelinMap_BC and thickness in HCP-S1200 data. Vertices with an absolute z-score larger than 5 (|z|&gt;5) in both metrics are shown in blue. The number of vertices with this threshold is termed as a surface defect score 5 (SDS5).</Description>
            <Image Encoding="Base64" Format="png"></Image>
        </SceneInfo>
        <SceneInfo Index="3">
            <Name>SubjectID Volume distortion map</Name>
            <BalsaSceneID></BalsaSceneID>
            <Description>Thresholded jacobian from the FNIRT non-linear volume registration (color) + subject's midthickness surface outline shown over the MNI152 volume space template.

Tab 1 is a coronal montage; Tab 2 is an axial montage.</Description>
            <Image Encoding="Base64" Format="png"></Image>
        </SceneInfo>
    </SceneInfoDirectory>
